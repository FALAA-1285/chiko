# =====================================================================
# Sistem operasi
# =====================================================================
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# =====================================================================
# Editor & IDE (pengaturan pribadi tiap developer)
# =====================================================================
*.iml
*.ipr
*.iws
.idea/
.vscode/
.atom/
.history
*.swp
*~

# =====================================================================
# Flutter / Dart / Pub — dibuat ulang otomatis oleh `flutter pub get` / build
# =====================================================================
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
**/doc/api/
**/ios/Flutter/.last_build_id
.widget_preview/
migrate_working_dir/

# Hasil test: coverage & gambar golden yang gagal
/coverage/
**/failures/

# Simbol & peta obfuscation dari build rilis
app.*.symbols
app.*.map.json

# Paket aplikasi yang tercecer di luar /build
*.apk
*.aab
*.ipa

# Android Studio menaruh artefak build di sini
/android/app/debug
/android/app/profile
/android/app/release

# =====================================================================
# Rahasia — JANGAN PERNAH di-commit
# =====================================================================
/android/key.properties
*.jks
*.keystore
.env
.env.*
*.env

# =====================================================================
# Data lokal & file sementara
# =====================================================================
# Database SQLite yang mungkin terbuat saat mencoba/menguji (data app asli ada di folder dokumen perangkat)
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.log
*.tmp
*.bak
tmp/

# Lain-lain
*.class
*.pyc
.build/
.buildlog/
.svn/
.swiftpm/
